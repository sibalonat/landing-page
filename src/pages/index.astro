---
import Layout from "../layouts/Layout.astro";
import redG from "../assets/gka/red-g.svg";
import mtksLogo from "../assets/mtks/mtks-logo.svg";
const baseUrl = "https://galeriakombetare.gov.al";
---

<Layout
  title="Galeria Kombëtare e Arteve | National Gallery of Arts"
  description="Faqja zyrtare e Galerisë Kombëtare të Arteve në Shqipëri."
  email="info@galeriakombetare.gov.al"
>
  <!-- Add structured data for SEO -->
  <script
    is:inline
    type="application/ld+json"
    slot="head"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Museum",
      name: "Galeria Kombëtare e Arteve",
      alternateName: "National Gallery of Arts of Albania",
      url: baseUrl,
      logo: `${baseUrl}${redG.src}`,
      image: `${baseUrl}/og-image.jpg`,
      description:
        "The National Gallery of Arts of Albania - showcasing Albanian and international art, contemporary exhibitions, and cultural heritage.",
      address: {
        "@type": "PostalAddress",
        streetAddress: "Bulevardi Dëshmorët e Kombit",
        addressLocality: "Tirana",
        postalCode: "1001",
        addressCountry: "AL",
      },
      contactPoint: {
        "@type": "ContactPoint",
        email: "info@galeriakombetare.gov.al",
        contactType: "Customer Service",
        availableLanguage: ["Albanian", "English"],
      },
      openingHoursSpecification: {
        "@type": "OpeningHoursSpecification",
        dayOfWeek: [
          "Tuesday",
          "Wednesday",
          "Thursday",
          "Friday",
          "Saturday",
          "Sunday",
        ],
        opens: "10:00",
        closes: "18:00",
      },
      sameAs: [
        "https://www.facebook.com/galeriakombetare",
        "https://www.instagram.com/galeriakombetare",
      ],
    })}
  />
  <!-- Logos slot content -->
  <div slot="logos" class="absolute inset-4 sm:inset-8 md:inset-12">
    <!-- GKA Logo Container -->
    <div
      id="gka-logo-container"
      class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-full max-w-30 sm:max-w-md md:w-125 lg:w-150"
    >
      <div class="relative flex items-center overflow-hidden">
        <!-- Static red G - always visible -->
        <img
          src={redG.src}
          alt=""
          class="w-20 sm:w-24 md:w-35 lg:w-57.5 h-auto object-contain pointer-events-none shrink-0"
        />

        <!-- Text Container - absolute positioning for overlap -->
        <div
          class="absolute left-7 sm:left-20 md:left-28 lg:left-23 font-mulish font-medium"
        >
          <!-- English text - fades out -->
          <div
            id="text-en"
            class="text-black absolute -top-5 md:-top-13 text-xs sm:text-base md:text-xl lg:text-[1.8rem] whitespace-nowrap"
            style="letter-spacing: 0.05em; line-height: 1;"
          >
            <div class="capitalize">National</div>
            <div class="capitalize">Gallery</div>
            <div>of <span class="capitalize">Arts</span></div>
          </div>

          <!-- Albanian text - fades in -->
          <div
            id="text-al"
            class="absolute text-black -top-5 md:-top-13 opacity-0 text-xs sm:text-base md:text-xl lg:text-[1.8rem] whitespace-nowrap"
            style="letter-spacing: 0.05em; line-height: 1;"
          >
            <div class="capitalize">Galeria</div>
            <div class="capitalize">Kombëtare</div>
            <div>e <span class="capitalize">Arteve</span></div>
          </div>
        </div>
      </div>
    </div>

    <!-- MTKS logo -->
    <img
      id="mtks-logo"
      src={mtksLogo.src}
      alt="MTKS logo"
      class="absolute -top-5 sm:top-8 md:top-15 right-2 sm:right-4 w-33 sm:w-24 md:w-36 lg:w-66 h-auto opacity-0"
    />
  </div>

  <!-- Open Call Section (default slot) -->
  <article class="border-t border-gray-200 dark:border-gray-700 pt-8 sm:pt-12">
    <h2
      class="text-lg sm:text-xl md:text-2xl lg:text-3xl font-kufam uppercase text-center mb-6 sm:mb-8 leading-tight"
    >
      Thirrje e hapur – Fondi i krijimtarisë 2026
    </h2>

    <div class="flex flex-col items-center space-y-4">
      <div
        class="text-gray-600 dark:text-gray-400 max-w-2xl space-y-4 text-center"
      >
        <p class="text-base sm:text-lg md:text-xl text-gray-700 dark:text-gray-300">
          Galeria Kombëtare e Arteve hap thirrjen për mbështetjen e prodhimit dhe
          prezantimit të veprave të reja në artet pamore.
        </p>
        <p class="text-sm sm:text-base">
          Ftohen të aplikojnë artistë shqiptarë, të rinj dhe të afirmuar, me
          projekte që zhvillojnë një vepër të re me qasje bashkëkohore.
        </p>
        <p class="text-sm sm:text-base font-semibold text-gray-800 dark:text-gray-200">
          Afati i aplikimit: 12 Qershor 2026, ora 14:00
        </p>
        <p class="text-sm sm:text-base">
          Veprat e përzgjedhura do të prezantohen në një ekspozitë, organizuar
          nga GKA.
        </p>
        <p class="text-sm sm:text-base">Aplikimet dorëzohen fizikisht dhe elektronikisht.</p>
      </div>

      <a
        id="download-open-call-btn"
        href="/documents/Dokumente Aplikimi GKA.zip"
        download
        class="inline-flex items-center gap-2 px-6 py-3 bg-black text-white dark:bg-white dark:text-black font-medium text-sm sm:text-base uppercase tracking-wide transition-all duration-300 hover:scale-105 hover:shadow-lg"
      >
        <svg
          class="w-5 h-5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
          ></path>
        </svg>
        Shkarko dokumentet
      </a>
    </div>
  </article>
</Layout>

<script>
  import { gsap } from "gsap";

  document.addEventListener("DOMContentLoaded", () => {
    const isMobile = window.innerWidth < 640;
    const isTablet = window.innerWidth >= 640 && window.innerWidth < 1024;

    const tl = gsap.timeline();

    // 1. Fade out English text with slide left
    tl.to("#text-en", {
      opacity: 0,
      x: -20,
      duration: isMobile ? 0.4 : 0.6,
      delay: isMobile ? 1 : 1.5,
      ease: "power2.in",
    });

    // 2. Fade in Albanian text with slide right
    tl.fromTo(
      "#text-al",
      {
        opacity: 0,
        x: 20,
      },
      {
        opacity: 1,
        x: 0,
        duration: isMobile ? 0.4 : 0.6,
        ease: "power2.out",
      },
      "-=0.2",
    );

    // 3. Move the entire GKA logo container to top-left with responsive positioning
    tl.to(
      "#gka-logo-container",
      {
        left: isMobile ? "3rem" : isTablet ? "0.75rem" : "1rem",
        top: isMobile ? "0.5rem" : isTablet ? "1rem" : "2rem",
        x: 0,
        y: 0,
        scale: isMobile ? 1 : isTablet ? 0.7 : 0.8,
        duration: isMobile ? 0.8 : 1,
        ease: "power2.inOut",
      },
      "+=0.5",
    );

    // 4. Fade in MTKS logo
    tl.to(
      "#mtks-logo",
      {
        opacity: 1,
        duration: isMobile ? 0.6 : 0.8,
      },
      "-=0.5",
    );
  });
</script>
