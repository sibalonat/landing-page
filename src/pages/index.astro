---
import Layout from "../layouts/Layout.astro";
import redG from "../assets/gka/red-g.svg";
import mtksLogo from "../assets/mtks/mtks-logo.svg";
---

<Layout title="Home" description="Landing page" email="contact@example.com">
  <!-- Logos slot content -->
  <div slot="logos" class="absolute inset-0">
    <!-- GKA Logo Container -->
    <div
      id="gka-logo-container"
      class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-40 sm:w-52"
    >
      <!-- Static red G - always visible -->
      <img
        src={redG.src}
        alt=""
        class="absolute inset-0 w-full h-auto object-contain pointer-events-none"
      />

      <!-- Text Container -->
      <div class="absolute inset-0 flex items-center justify-center">
        <!-- English text - fades out -->
        <div
          id="text-en"
          class="absolute text-center font-bold text-red-600 uppercase whitespace-nowrap"
          style="font-size: 0.65rem; letter-spacing: 0.02em;"
        >
          <div>Galeria</div>
          <div style="margin-top: -0.15em;">Kombëtare</div>
          <div style="margin-top: -0.15em;">e Arteve</div>
        </div>

        <!-- Albanian text - fades in -->
        <div
          id="text-al"
          class="absolute text-center font-bold text-red-600 uppercase opacity-0 whitespace-nowrap"
          style="font-size: 0.65rem; letter-spacing: 0.02em;"
        >
          <div>Galeria</div>
          <div style="margin-top: -0.15em;">Kombëtare</div>
          <div style="margin-top: -0.15em;">e Arteve</div>
        </div>
      </div>
    </div>

    <!-- MTKS logo -->
    <img
      id="mtks-logo"
      src={mtksLogo.src}
      alt="MTKS logo"
      class="absolute top-8 right-4 w-28 sm:w-36 h-auto opacity-0"
    />
  </div>
</Layout>

<style>
  /* Import a condensed font for better match */
  @import url("https://fonts.googleapis.com/css2?family=Roboto+Condensed:wght@700&display=swap");

  #text-en,
  #text-al {
    font-family: "Roboto Condensed", "Arial Narrow", sans-serif;
    line-height: 1;
  }
</style>

<script>
  import { gsap } from "gsap";

  document.addEventListener("DOMContentLoaded", () => {
    const tl = gsap.timeline();

    // 1. Fade out English text
    tl.to("#text-en", {
      opacity: 0,
      duration: 0.6,
      delay: 1.5,
    });

    // 2. Fade in Albanian text
    tl.to(
      "#text-al",
      {
        opacity: 1,
        duration: 0.6,
      },
      "+=0.3"
    );

    // 3. Move the entire GKA logo container to top-left
    tl.to(
      "#gka-logo-container",
      {
        left: "1rem",
        top: "2rem",
        x: 0,
        y: 0,
        scale: 0.8,
        duration: 1,
        ease: "power2.inOut",
      },
      "+=0.5"
    );

    // 4. Fade in MTKS logo
    tl.to(
      "#mtks-logo",
      {
        opacity: 1,
        duration: 0.8,
      },
      "-=0.5"
    );
  });
</script>
