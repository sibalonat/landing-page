---
import Layout from "../layouts/Layout.astro";
import redG from "../assets/gka/red-g.svg";
import mtksLogo from "../assets/mtks/mtks-logo.svg";
---

<Layout
  title="Galeria Kombëtare e Arteve | National Gallery of Arts"
  description="Faqja zyrtare e Galerisë Kombëtare të Arteve në Shqipëri."
  email="info@galeriakombetare.gov.al"
>
  <!-- Logos slot content -->
  <div slot="logos" class="absolute inset-12">
    <!-- GKA Logo Container -->
    <div
      id="gka-logo-container"
      class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-125 sm:w-150"
    >
      <div class="relative flex items-center">
        <!-- Static red G - always visible -->
        <img
          src={redG.src}
          alt=""
          class="w-35 sm:w-47.5 h-auto object-contain pointer-events-none shrink-0"
        />

        <!-- Text Container - positioned to the right of the G -->
        <div class="ml-0flex-1 flex itemscenter">
          <!-- English text - fades out -->
          <div
            id="text-en"
            class="-ml-30 -mt-2 text-black capitalize"
            style="font-size: 1.8rem; letter-spacing: 0.05em; line-height: 1;"
          >
            <div>National</div>
            <div>Gallery</div>
            <div>of Arts</div>
          </div>

          <!-- Albanian text - fades in -->
          <div
            id="text-al"
            class="-ml-32 -mt-2 text-black opacity-0 capitalize"
            style="font-size: 1.8rem; letter-spacing: 0.05em; line-height: 1;"
          >
            <div>Galeria</div>
            <div>Kombëtare</div>
            <div>e Arteve</div>
          </div>
        </div>
      </div>
    </div>

    <!-- MTKS logo -->
    <img
      id="mtks-logo"
      src={mtksLogo.src}
      alt="MTKS logo"
      class="absolute -top-7 right-4 w-28 sm:w-66 h-auto opacity-0"
    />
  </div>
</Layout>

<style>
  /* Import a condensed font for better match */
  @import url("https://fonts.googleapis.com/css2?family=Roboto+Condensed:wght@700&display=swap");

  #text-en,
  #text-al {
    font-family: "Roboto Condensed", "Arial Narrow", sans-serif;
  }
</style>

<script>
  import { gsap } from "gsap";

  document.addEventListener("DOMContentLoaded", () => {
    const tl = gsap.timeline();

    // 1. Fade out English text
    tl.to("#text-en", {
      opacity: 0,
      duration: 0.6,
      delay: 1.5,
    });

    // 2. Fade in Albanian text
    tl.to(
      "#text-al",
      {
        opacity: 1,
        duration: 0.6,
      },
      "+=0.3"
    );

    // 3. Move the entire GKA logo container to top-left
    tl.to(
      "#gka-logo-container",
      {
        left: "1rem",
        top: "2rem",
        x: 0,
        y: 0,
        scale: 0.8,
        duration: 1,
        ease: "power2.inOut",
      },
      "+=0.5"
    );

    // 4. Fade in MTKS logo
    tl.to(
      "#mtks-logo",
      {
        opacity: 1,
        duration: 0.8,
      },
      "-=0.5"
    );
  });
</script>
