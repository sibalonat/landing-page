---
import Layout from "../layouts/Layout.astro";
import enLogo from "../assets/gka/en-logo.svg";
import alLogo from "../assets/gka/al-logo.svg";
import mtksLogo from "../assets/mtks/mtks-logo.svg";
---

<Layout title="Home" description="Landing page" email="contact@example.com">
  <!-- Logos slot content -->
  <div slot="logos" class="absolute inset-0">
    <!-- EN→AL pair: start centered, then move to top-left -->
    <div
      class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-40 sm:w-52 h-40 sm:h-52 animate-pair-to-top-left"
    >
      <img
        src={enLogo.src}
        alt="GKA English logo"
        class="absolute inset-0 w-full h-full object-contain animate-logo-en-out"
      />
      <img
        src={alLogo.src}
        alt="GKA Albanian logo"
        class="absolute inset-0 w-full h-full object-contain animate-logo-al-in"
      />
    </div>

    <!-- MTKS: fade in at top-right after the pair moves -->
    <img
      src={mtksLogo.src}
      alt="MTKS logo"
      class="absolute top-0 right-0 w-28 sm:w-36 h-auto opacity-0 animate-mtks-fade-in [animation-delay:2400ms]"
    />
  </div>

  <!-- Optional extra content goes here -->
</Layout>
