---
interface Props {
  title?: string;
  description?: string;
  email?: string;
}
const {
  title = "GKA",
  description = "Landing page",
  email = "info@galeriakombetare.gov.al",
} = Astro.props;
import "../styles/global.css";
import accunthisaFont from "../styles/fonts/accanthisa.woff2";
import kufamFont from "../styles/fonts/kufam.woff2";
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <link
      rel="preload"
      href={accunthisaFont}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={kufamFont}
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>

  <body
    class="min-h-screen flex flex-col bg-white text-gray-900 dark:bg-gray-900 dark:text-gray-100"
  >
    <main class="flex-1 flex flex-col">
      <!-- ~65vh hero with golden-ratio inner box. Stays at full size and
           scrolls out of view normally as the user scrolls past it. -->
      <section
        id="hero-section"
        class="order-1 min-h-[65vh] flex items-center justify-center relative px-4 sm:px-6"
      >
        <div class="relative w-full max-w-5xl aspect-[1.618] pt-4 sm:pt-8">
          <!-- Logos injected by page -->
          <slot name="logos" />

          <!-- Coming soon + animated email -->
          <div
            id="hero-bottom-content"
            class="absolute bottom-2 sm:bottom-4 left-1/2 -translate-x-1/2 text-center space-y-1 sm:space-y-2 w-full px-4"
          >
            <p
              id="coming-soon-text"
              class="text-xl sm:text-4xl md:text-5xl lg:text-6xl font-kufam uppercase font-semibold"
            >
            </p>
            <div id="contact-container" class="opacity-0">
              <span
                id="contact-label"
                class="inline-block text-xs sm:text-sm md:text-base uppercase tracking-wider opacity-0"
                >Contact</span
              >
              <a
                id="email-link"
                href={`mailto:${email}`}
                class="block text-slate-700 font-accunthisa font-medium mt-1 text-sm sm:text-base md:text-lg opacity-0 break-all"
              >
                {email}
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- Open Call Results Section -->
      <section
        id="results-section"
        class="order-2 hidden relative z-10 bg-white dark:bg-gray-900 -mt-[28vh] sm:-mt-[32vh] lg:-mt-[38vh] mx-auto max-w-4xl w-full px-4 sm:px-6 lg:px-8 py-8 sm:py-12 lg:py-16"
      >
        <article
          class="border-t border-gray-200 dark:border-gray-700 pt-8 sm:pt-12"
        >
          <p
            class="text-xs sm:text-sm font-kufam uppercase tracking-wider text-center text-gray-500 dark:text-gray-400 mb-2"
          >
            Njoftim
          </p>
          <h2
            class="text-lg sm:text-xl md:text-2xl lg:text-3xl font-kufam uppercase text-center mb-6 sm:mb-8 leading-tight"
          >
            Rezultatet e Thirrjes së Hapur – Fondi i Krijimtarisë 2026
          </h2>

          <div class="flex flex-col items-center space-y-4">
            <div
              class="text-gray-600 dark:text-gray-400 max-w-2xl space-y-4 text-center"
            >
              <p
                class="text-base sm:text-lg md:text-xl text-gray-700 dark:text-gray-300"
              >
                Galeria Kombëtare e Arteve shpall listën e përfituesve të
                mbështetjes financiare për projekt-propozimet e dorëzuara në
                kuadër të Thirrjes së Hapur „Fondi i Krijimtarisë 2026”.
              </p>
              <p
                class="text-sm sm:text-base font-semibold text-gray-800 dark:text-gray-200"
              >
                Numri përfundimtar i projekteve që do të mbështeten financiarisht
                nga Galeria Kombëtare e Arteve në kuadër të Thirrjes së Hapur
                „Fondi i Krijimtarisë 2026” është 16 (gjashtëmbëdhjetë).
              </p>
              <p class="text-sm sm:text-base">
                Njoftimin e plotë me fituesit do ta gjeni në dokumentin më poshtë.
              </p>
            </div>

            <a
              href="/documents/njoftim-rezultatet-fondi-krijimtarise-2026.pdf"
              download
              class="inline-flex items-center gap-2 px-6 py-3 bg-black text-white dark:bg-white dark:text-black font-medium text-sm sm:text-base uppercase tracking-wide transition-all duration-300 hover:scale-105 hover:shadow-lg"
            >
              <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                ></path>
              </svg>
              Shkarko Njoftimin
            </a>
          </div>
        </article>
      </section>

      <!-- Job Posting Section -->
      <section
        id="job-posting"
        class="order-5 relative z-10 bg-white dark:bg-gray-900 mx-auto max-w-4xl w-full px-4 sm:px-6 lg:px-8 py-8 sm:py-12 lg:py-16 opacity-0"
      >
        <div
          class="border-t border-gray-200 dark:border-gray-700 pt-8 sm:pt-12"
        >
          <h2
            class="text-lg sm:text-xl md:text-2xl lg:text-3xl font-kufam uppercase text-center mb-6 sm:mb-8 leading-tight"
          >
            Thirrje për aplikim si këshilltar i jashtëm pranë drejtorit të
            Galerisë Kombëtare të Arteve
          </h2>

          <div class="flex flex-col items-center space-y-4">
            <p
              class="text-sm sm:text-base text-center text-gray-600 dark:text-gray-400 max-w-2xl"
            >
              Për më shumë informacion mbi pozicionin dhe kërkesat për aplikim,
              ju lutemi shkarkoni dokumentin e plotë.
            </p>

            <a
              href="/documents/thirrje-keshilltar.pdf"
              download
              class="inline-flex items-center gap-2 px-6 py-3 bg-black text-white dark:bg-white dark:text-black font-medium text-sm sm:text-base uppercase tracking-wide transition-all duration-300 hover:scale-105 hover:shadow-lg"
            >
              <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                ></path>
              </svg>
              Shkarko Dokumentin
            </a>
          </div>
        </div>
      </section>

      <!-- Këshilltar i Jashtëm – Njoftim për Publikim Section -->
      <section
        id="keshilltar-publikim"
        class="order-6 relative z-10 bg-white dark:bg-gray-900 mx-auto max-w-4xl w-full px-4 sm:px-6 lg:px-8 py-8 sm:py-12 lg:py-16 opacity-0"
      >
        <div
          class="border-t border-gray-200 dark:border-gray-700 pt-8 sm:pt-12"
        >
          <h2
            class="text-lg sm:text-xl md:text-2xl lg:text-3xl font-kufam uppercase text-center mb-6 sm:mb-8 leading-tight"
          >
            Thirrje për aplikim si këshilltar i jashtëm pranë drejtorit të
            Galerisë Kombëtare të Arteve
          </h2>

          <div class="flex flex-col items-center space-y-4">
            <div
              class="text-gray-600 dark:text-gray-400 max-w-2xl space-y-4 text-center"
            >
              <p class="text-sm sm:text-base">
                Galeria Kombëtare e Arteve shpall thirrje të hapur për
                angazhimin e një Këshilltari të Jashtëm me profil teknik, për
                mbështetje teknike dhe hapësinore në realizimin e projektit
                ekspozues të linjës muzeale. Kohëzgjatja: 12 muaj.
              </p>
              <p
                class="text-sm sm:text-base font-semibold text-gray-800 dark:text-gray-200"
              >
                Afati i aplikimit: 29 Korrik 2026. Konkurimi zhvillohet më
                30 Korrik 2026, ora 10:00.
              </p>
              <p class="text-sm sm:text-base">
                Për më shumë informacion mbi pozicionin dhe kërkesat për
                aplikim, ju lutemi shkarkoni dokumentin e plotë.
              </p>
            </div>

            <a
              href="/documents/thirrje-keshilltar-jashtem-2026.pdf"
              download
              class="inline-flex items-center gap-2 px-6 py-3 bg-black text-white dark:bg-white dark:text-black font-medium text-sm sm:text-base uppercase tracking-wide transition-all duration-300 hover:scale-105 hover:shadow-lg"
            >
              <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                ></path>
              </svg>
              Shkarko Dokumentin
            </a>
          </div>
        </div>
      </section>

      <!-- Maintenance Worker (Sanitar) Job Posting Section -->
      <section
        id="sanitar-posting"
        class="order-4 relative z-10 bg-white dark:bg-gray-900 mx-auto max-w-4xl w-full px-4 sm:px-6 lg:px-8 py-8 sm:py-12 lg:py-16 opacity-0"
      >
        <div
          class="border-t border-gray-200 dark:border-gray-700 pt-8 sm:pt-12"
        >
          <h2
            class="text-lg sm:text-xl md:text-2xl lg:text-3xl font-kufam uppercase text-center mb-6 sm:mb-8 leading-tight"
          >
            Njoftim për vend të lirë pune – Punonjës Mirëmbajtje (Sanitar)
          </h2>

          <div class="flex flex-col items-center space-y-4">
            <div
              class="text-gray-600 dark:text-gray-400 max-w-2xl space-y-4 text-center"
            >
              <p class="text-sm sm:text-base">
                Punonjës Mirëmbajtje (Sanitar) në Sektorin e Sigurisë dhe
                Mirëmbajtjes në GKA, me afat të caktuar.
              </p>
              <p
                class="text-sm sm:text-base font-semibold text-gray-800 dark:text-gray-200"
              >
                Aplikimet do të pranohen deri më datë 09.06.2026.
              </p>
              <p class="text-sm sm:text-base">
                Për më shumë informacion mbi pozicionin dhe kërkesat për
                aplikim, ju lutemi shkarkoni dokumentin e plotë.
              </p>
            </div>

            <a
              href="/documents/Njoftim per shpalljen e vendit te lire te punes - Punonjes Mirembajtje_GKA.pdf"
              download
              class="inline-flex items-center gap-2 px-6 py-3 bg-black text-white dark:bg-white dark:text-black font-medium text-sm sm:text-base uppercase tracking-wide transition-all duration-300 hover:scale-105 hover:shadow-lg"
            >
              <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                ></path>
              </svg>
              Shkarko Dokumentin
            </a>
          </div>
        </div>
      </section>

      <section
        id="open-call-section"
        class="order-3 relative z-10 bg-white dark:bg-gray-900 mx-auto max-w-4xl w-full px-4 sm:px-6 lg:px-8 py-8 sm:py-12 lg:py-16 opacity-0"
      >
        <slot />
      </section>

      <!-- Compact footer: site-under-construction (left) + contact (right) -->
      <footer
        id="site-footer"
        class="order-last hidden relative z-10 bg-white dark:bg-gray-900 border-t border-gray-200 dark:border-gray-700 mt-auto"
      >
        <div
          class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-5 sm:py-6 flex flex-col sm:flex-row items-center justify-between gap-3 sm:gap-6 text-center"
        >
          <span
            class="font-kufam uppercase font-semibold text-sm sm:text-base md:text-lg"
          >
            Site Under Construction
          </span>
          <a
            href={`mailto:${email}`}
            class="font-accunthisa text-sm sm:text-base text-slate-700 dark:text-slate-300 hover:underline break-all"
          >
            {email}
          </a>
        </div>
      </footer>
    </main>

    <script>
      import { gsap } from "gsap";
      import { TextPlugin } from "gsap/TextPlugin";

      gsap.registerPlugin(TextPlugin);

      document.addEventListener("DOMContentLoaded", () => {
        const comingSoonText = document.getElementById("coming-soon-text");
        const contactContainer = document.getElementById("contact-container");
        const contactLabel = document.getElementById("contact-label");
        const emailLink = document.getElementById("email-link");

        if (comingSoonText && contactContainer && contactLabel && emailLink) {
          const tl = gsap.timeline();

          // 1. Typing animation for "Site Under Construction"
          tl.to(comingSoonText, {
            duration: 1.2,
            text: "Site Under Construction",
            delay: 0.3,
            ease: "none",
          });

          // 2. Fade in contact container
          tl.to(
            contactContainer,
            {
              opacity: 1,
              duration: 0.3,
            },
            "+=0.5",
          );

          // 3. Slide in "Contact" label - reduced animation on mobile
          const isMobile = window.innerWidth < 640;
          tl.fromTo(
            contactLabel,
            {
              opacity: 0,
              x: isMobile ? -15 : -30,
              rotation: isMobile ? 0 : -5,
            },
            {
              opacity: 1,
              x: 0,
              rotation: 0,
              duration: 0.6,
              ease: "back.out(1.7)",
            },
          );

          // 4. Slide in email - reduced animation on mobile
          tl.fromTo(
            emailLink,
            {
              opacity: 0,
              x: isMobile ? 15 : 30,
              y: isMobile ? 0 : -10,
            },
            {
              opacity: 1,
              x: 0,
              y: 0,
              duration: 0.8,
              ease: "elastic.out(1, 0.5)",
            },
            "-=0.3",
          );

          // 5. Gentle continuous pulse on email - reduced on mobile
          tl.to(
            emailLink,
            {
              scale: isMobile ? 1.02 : 1.05,
              duration: 2,
              repeat: -1,
              yoyo: true,
              ease: "sine.inOut",
            },
            "+=0.5",
          );

          // 6. After load + ~5s, fade out only the "Site Under Construction"
          // text + email from inside the hero. The hero/logos never resize
          // or move — the user simply scrolls past the hero to see the new
          // sections below.
          const heroBottomContent = document.getElementById("hero-bottom-content");
          const resultsSection = document.getElementById("results-section");
          const openCallSection = document.getElementById("open-call-section");
          const siteFooter = document.getElementById("site-footer");
          const jobPosting = document.getElementById("job-posting");
          const sanitarPosting = document.getElementById("sanitar-posting");
          const keshilltarPublikim = document.getElementById("keshilltar-publikim");

          if (
            heroBottomContent &&
            resultsSection &&
            openCallSection &&
            siteFooter &&
            jobPosting &&
            sanitarPosting &&
            keshilltarPublikim
          ) {
            const transitionTl = gsap.timeline({ delay: 3.5 });

            // Phase 1: Fade out only the text + email. Logos and hero stay put.
            transitionTl.to(heroBottomContent, {
              opacity: 0,
              duration: 0.7,
              ease: "power2.in",
            });

            // Phase 2: Reveal the new sections (results, open-call, job-posting, footer).
            transitionTl.add(() => {
              heroBottomContent.style.display = "none";
              resultsSection.classList.remove("hidden");
              siteFooter.classList.remove("hidden");

              gsap.set(resultsSection, { opacity: 0, y: 30 });
              gsap.set(openCallSection, { opacity: 0, y: 30 });
              gsap.set(sanitarPosting, { opacity: 0, y: 30 });
              gsap.set(jobPosting, { opacity: 0, y: 30 });
              gsap.set(keshilltarPublikim, { opacity: 0, y: 30 });
              gsap.set(siteFooter, { opacity: 0, y: 30 });
            });

            // Phase 3: results (NJOFTIM) slides + fades in first.
            transitionTl.to(resultsSection, {
              y: 0,
              opacity: 1,
              duration: 1,
              ease: "power3.out",
            });

            // Phase 4: open-call (THIRRJE) follows, slightly overlapping.
            transitionTl.to(
              openCallSection,
              {
                y: 0,
                opacity: 1,
                duration: 0.9,
                ease: "power3.out",
              },
              "-=0.4",
            );

            // Phase 5: sanitar job posting follows, slightly overlapping.
            transitionTl.to(
              sanitarPosting,
              {
                y: 0,
                opacity: 1,
                duration: 0.9,
                ease: "power3.out",
              },
              "-=0.4",
            );

            // Phase 6: job-posting (këshilltar) follows, slightly overlapping.
            transitionTl.to(
              jobPosting,
              {
                y: 0,
                opacity: 1,
                duration: 0.9,
                ease: "power3.out",
              },
              "-=0.4",
            );

            // Phase 7: këshilltar (njoftim për publikim) follows, slightly overlapping.
            transitionTl.to(
              keshilltarPublikim,
              {
                y: 0,
                opacity: 1,
                duration: 0.9,
                ease: "power3.out",
              },
              "-=0.4",
            );

            // Phase 8: footer settles into place last.
            transitionTl.to(
              siteFooter,
              {
                y: 0,
                opacity: 1,
                duration: 0.8,
                ease: "power3.out",
              },
              "-=0.4",
            );
          }
        }
      });
    </script>
  </body>
</html>
