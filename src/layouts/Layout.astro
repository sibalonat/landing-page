---
interface Props {
  title?: string;
  description?: string;
  email?: string;
}
const {
  title = "GKA",
  description = "Landing page",
  email = "contact@example.com",
} = Astro.props;
import "../styles/global.css";
import accunthisaFont from "../assets/fonts/accunthisa.woff2";
import kufamFont from "../assets/fonts/kufam.woff2";
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link
      rel="preload"
      href={accunthisaFont}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={kufamFont}
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>

  <body
    class="min-h-screen flex flex-col bg-white text-gray-900 dark:bg-gray-900 dark:text-gray-100"
  >
    <main class="flex-1">
      <!-- ~65vh hero with golden-ratio inner box -->
      <section class="min-h-[65vh] flex items-center justify-center relative">
        <div class="relative w-full max-w-5xl aspect-[1.618]">
          <!-- Logos injected by page -->
          <slot name="logos" />

          <!-- Coming soon + animated email -->
          <div
            class="absolute bottom-4 left-1/2 -translate-x-1/2 text-center space-y-2"
          >
            <p
              class="text-xl sm:text-2xl font-semibold opacity-0 animate-fade-in-up [animation-delay:4200ms]"
            >
              Coming soon
            </p>
            <a
              href={`mailto:${email}`}
              class="inline-block text-blue-600 dark:text-blue-400 font-medium opacity-0 animate-fade-in-up animate-pulse-slow [animation-delay:5000ms]"
            >
              {email}
            </a>
          </div>
        </div>
      </section>

      <section
        class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8 sm:py-12 lg:py-16"
      >
        <slot />
      </section>
    </main>
  </body>
</html>
