---
interface Props {
  title?: string;
  description?: string;
  email?: string;
}
const {
  title = "GKA",
  description = "Landing page",
  email = "info@galeriakombetare.gov.al",
} = Astro.props;
import "../styles/global.css";
import accunthisaFont from "../styles/fonts/accanthisa.woff2";
import kufamFont from "../styles/fonts/kufam.woff2";
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link
      rel="preload"
      href={accunthisaFont}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={kufamFont}
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>

  <body
    class="min-h-screen flex flex-col bg-white text-gray-900 dark:bg-gray-900 dark:text-gray-100"
  >
    <main class="flex-1">
      <!-- ~65vh hero with golden-ratio inner box -->
      <section
        class="min-h-[65vh] flex items-center justify-center relative px-4 sm:px-6"
      >
        <div class="relative w-full max-w-5xl aspect-[1.618] pt-4 sm:pt-8">
          <!-- Logos injected by page -->
          <slot name="logos" />

          <!-- Coming soon + animated email -->
          <div
            class="absolute bottom-2 sm:bottom-4 left-1/2 -translate-x-1/2 text-center space-y-1 sm:space-y-2 w-full px-4"
          >
            <p
              id="coming-soon-text"
              class="text-xl sm:text-4xl md:text-5xl lg:text-6xl font-kufam uppercase font-semibold"
            >
            </p>
            <div id="contact-container" class="opacity-0">
              <span
                id="contact-label"
                class="inline-block text-xs sm:text-sm md:text-base uppercase tracking-wider opacity-0"
                >Contact</span
              >
              <a
                id="email-link"
                href={`mailto:${email}`}
                class="block text-slate-700 font-accunthisa font-medium mt-1 text-sm sm:text-base md:text-lg opacity-0 break-all"
              >
                {email}
              </a>
            </div>
          </div>
        </div>
      </section>

      <section
        class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8 sm:py-12 lg:py-16"
      >
        <slot />
      </section>
    </main>

    <script>
      import { gsap } from "gsap";
      import { TextPlugin } from "gsap/TextPlugin";

      gsap.registerPlugin(TextPlugin);

      document.addEventListener("DOMContentLoaded", () => {
        const comingSoonText = document.getElementById("coming-soon-text");
        const contactContainer = document.getElementById("contact-container");
        const contactLabel = document.getElementById("contact-label");
        const emailLink = document.getElementById("email-link");

        if (comingSoonText && contactContainer && contactLabel && emailLink) {
          const tl = gsap.timeline();

          // 1. Typing animation for "Coming soon"
          tl.to(comingSoonText, {
            duration: 2,
            text: "Coming soon",
            delay: 4.2,
            ease: "none",
          });

          // 2. Fade in contact container
          tl.to(
            contactContainer,
            {
              opacity: 1,
              duration: 0.3,
            },
            "+=0.5"
          );

          // 3. Slide in "Contact" label - reduced animation on mobile
          const isMobile = window.innerWidth < 640;
          tl.fromTo(
            contactLabel,
            {
              opacity: 0,
              x: isMobile ? -15 : -30,
              rotation: isMobile ? 0 : -5,
            },
            {
              opacity: 1,
              x: 0,
              rotation: 0,
              duration: 0.6,
              ease: "back.out(1.7)",
            }
          );

          // 4. Slide in email - reduced animation on mobile
          tl.fromTo(
            emailLink,
            {
              opacity: 0,
              x: isMobile ? 15 : 30,
              y: isMobile ? 0 : -10,
            },
            {
              opacity: 1,
              x: 0,
              y: 0,
              duration: 0.8,
              ease: "elastic.out(1, 0.5)",
            },
            "-=0.3"
          );

          // 5. Gentle continuous pulse on email - reduced on mobile
          tl.to(
            emailLink,
            {
              scale: isMobile ? 1.02 : 1.05,
              duration: 2,
              repeat: -1,
              yoyo: true,
              ease: "sine.inOut",
            },
            "+=0.5"
          );
        }
      });
    </script>
  </body>
</html>
