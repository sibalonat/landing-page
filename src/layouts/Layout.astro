---
interface Props {
  title?: string;
  description?: string;
  email?: string;
}
const {
  title = "GKA",
  description = "Landing page",
  email = "contact@example.com",
} = Astro.props;
import "../styles/global.css";
import accunthisaFont from "../styles/fonts/accanthisa.woff2";
import kufamFont from "../styles/fonts/kufam.woff2";
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link
      rel="preload"
      href={accunthisaFont}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={kufamFont}
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>

  <body
    class="min-h-screen flex flex-col bg-white text-gray-900 dark:bg-gray-900 dark:text-gray-100"
  >
    <main class="flex-1">
      <!-- ~65vh hero with golden-ratio inner box -->
      <section class="min-h-[65vh] flex items-center justify-center relative">
        <div class="relative w-full max-w-5xl aspect-[1.618] pt-8">
          <!-- Logos injected by page -->
          <slot name="logos" />

          <!-- Coming soon + animated email -->
          <div
            class="absolute bottom-4 left-1/2 -translate-x-1/2 text-center space-y-2"
          >
            <p
              id="coming-soon-text"
              class="text-xl font-kufam uppercase sm:text-6xl font-semibold"
            >
            </p>
            <span class="inline-block">Contact</span>
            <a
              id="email-link"
              href={`mailto:${email}`}
              class="inline-block text-blue-600 dark:text-blue-400 font-medium opacity-0"
            >
              {email}
            </a>
          </div>
        </div>
      </section>

      <section
        class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8 sm:py-12 lg:py-16"
      >
        <slot />
      </section>
    </main>

    <script>
      import { gsap } from "gsap";
      import { TextPlugin } from "gsap/TextPlugin";

      gsap.registerPlugin(TextPlugin);

      document.addEventListener("DOMContentLoaded", () => {
        const comingSoonText = document.getElementById("coming-soon-text");
        const emailLink = document.getElementById("email-link");

        if (comingSoonText && emailLink) {
          // Typing animation for "Coming soon"
          gsap.to(comingSoonText, {
            duration: 2,
            text: "Coming soon",
            delay: 4.2,
            ease: "none",
          });

          // Fade in email with pulse
          gsap.to(emailLink, {
            opacity: 1,
            duration: 0.8,
            delay: 5,
            ease: "power2.out",
          });

          // Pulse animation for email
          gsap.to(emailLink, {
            scale: 1.03,
            duration: 1.8,
            repeat: -1,
            yoyo: true,
            ease: "power1.inOut",
            delay: 5.8,
          });
        }
      });
    </script>
  </body>
</html>
