---
interface Props {
  title?: string;
  description?: string;
  email?: string;
}
const {
  title = "GKA",
  description = "Landing page",
  email = "contact@example.com",
} = Astro.props;
import "../styles/global.css";
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <!-- Preload fonts -->
    <link
      rel="preload"
      href="/fonts/accunthisa.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/kufam.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>

  <body
    class="min-h-screen flex flex-col bg-white text-gray-900 dark:bg-gray-900 dark:text-gray-100"
  >
    <!-- Minimal header -->
    <header class="border-b border-gray-200 dark:border-gray-800">
      <div
        class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 h-14 flex items-center"
      >
        <a href="/" class="font-semibold text-lg sm:text-xl">GKA</a>
      </div>
    </header>

    <!-- Hero (65vh, golden-ratio inner box) -->
    <main class="flex-1">
      <section class="min-h-[65vh] flex items-center justify-center relative">
        <div class="relative w-full max-w-5xl aspect-[1.618]">
          <!-- Inject logos: EN→AL swap, then drift to top-left; MTKS fades in to the right -->
          <div
            class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 animate-hero-move"
          >
            <slot name="logos" />
          </div>

          <!-- Coming soon + animated email -->
          <div
            class="absolute bottom-4 left-1/2 -translate-x-1/2 text-center space-y-2"
          >
            <p
              class="text-xl sm:text-2xl font-semibold opacity-0 animate-fade-in-up [animation-delay:2600ms]"
            >
              Coming soon
            </p>
            <a
              href={`mailto:${email}`}
              class="inline-block text-blue-600 dark:text-blue-400 font-medium opacity-0 animate-fade-in-up animate-pulse-slow [animation-delay:3400ms]"
            >
              {email}
            </a>
          </div>
        </div>
      </section>

      <!-- Optional extra content -->
      <section
        class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8 sm:py-12 lg:py-16"
      >
        <slot />
      </section>
    </main>

    <!-- Minimal footer -->
    <footer class="border-t border-gray-200 dark:border-gray-800">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8 text-sm">
        © {new Date().getFullYear()} GKA
      </div>
    </footer>
  </body>
</html>
